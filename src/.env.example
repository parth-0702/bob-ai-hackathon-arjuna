# Copy to src/backend/.env. Keep credentials server-side and uncommitted.
# Default paths work without configuration; optional overrides must be absolute.
# FAILURE_MODEL_PATH=E:/PROJECTS/IBM/Bob-IBM-Plus/src/backend/models/model1_failure_risk_weather.pkl
# PORT_DATABASE_PATH=E:/PROJECTS/IBM/Bob-IBM-Plus/src/backend/data/portsentinel.sqlite3
FAILURE_POSITIVE_CLASS_CONFIRMED=false
# Optional local operator gate. This is not production identity management.
OPERATOR_TOKEN=
LLM_PROVIDER=groq
# Groq credentials stay on the backend; never expose this key in the frontend.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
